{
  "name": "souvenir-galore",
  "version": "1.0.0",
  "private": true,
  "description": "Souvenir Galore — handmade gifts, candles, décor and keepsakes from Lebanon. Full-stack Next.js e-commerce platform.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "vercel-build": "npm run db:deploy && npm run build",
    "netlify-build": "node scripts/netlify-build.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-local.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:demo": "tsx prisma/demo-seed.ts",
    "db:demo:remove": "tsx scripts/remove-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "maintenance:cleanup": "tsx scripts/cleanup.ts",
    "backup": "bash scripts/backup.sh",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "clsx": "^2.1.1",
    "next": "^16.0.10",
    "nodemailer": "^6.10.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "three": "0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.170.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
