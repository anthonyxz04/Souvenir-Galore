# Environment variables for Netlify.
# In Netlify: Project configuration → Environment variables → Add a variable →
# "Import from a .env file", then paste these lines with your real values.
# Never commit the filled-in version. See docs/NETLIFY.md.

# PostgreSQL (e.g. Neon). Pooled connection string for the app…
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# …and the direct (non-pooled) one, used only to update the tables during builds.
MIGRATE_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 40+ random letters and numbers (from a password generator). Keep it secret.
APP_SECRET="replace-with-a-long-random-string"
# Another random value; lets Netlify run the daily cleanup.
CRON_SECRET="replace-with-another-long-random-string"

# Photos are stored in Netlify Blobs (included with Netlify, no extra account).
STORAGE_DRIVER="netlify"
TRUST_PROXY="true"

# Your owner account, created on the first deploy. Delete ADMIN_PASSWORD after you sign in.
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD="choose-a-strong-password"

# Email (needed for account verification, password resets and order emails).
# Any SMTP provider works, e.g. Resend: host smtp.resend.com, port 465, user "resend",
# password = your Resend API key. Leave empty to set up later.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
ADMIN_NOTIFICATION_EMAILS=""

# Optional: your own domain once connected (otherwise Netlify's address is used automatically).
# APP_URL="https://www.yourdomain.com"
