# ─────────────────────────────────────────────────────────────
# Souvenir Galore — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or real credentials to source control.
# ─────────────────────────────────────────────────────────────

# Public URL of the site, without a trailing slash. Used for links in emails,
# canonical URLs, the sitemap and Open Graph tags. On Netlify you can leave it
# out: the site address Netlify provides (URL) is used automatically.
APP_URL="http://localhost:3000"

# PostgreSQL connection string.
# Local example: postgresql://souvenir:CHANGE_ME@localhost:5432/souvenir_galore
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: a DIRECT (non-pooled) connection used only for migrations, when
# DATABASE_URL goes through a connection pooler (e.g. Neon's "-pooler" host,
# which also needs "&pgbouncer=true" added to DATABASE_URL).
MIGRATE_DATABASE_URL=""

# Only for docker-compose.yml: password for the bundled PostgreSQL container.
# docker-compose builds DATABASE_URL from it automatically. Use a long random
# value (letters and digits only avoids URL-encoding issues).
POSTGRES_PASSWORD=""

# Separate database used only by the integration and end-to-end tests.
# It is wiped between test runs — never point it at production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/souvenir_galore_test?schema=public"

# Random secret (at least 32 characters) used to hash IP addresses in logs
# and sign small tokens. Generate one with:  openssl rand -base64 48
APP_SECRET="replace-with-a-long-random-string"

# Set to "true" when the app runs behind a proxy/CDN that sets X-Forwarded-For
# (Vercel, Cloudflare, Nginx). Used for rate limiting by IP.
TRUST_PROXY="true"

# ── Image storage ────────────────────────────────────────────
# "local"   stores files on disk (development / single server with a volume).
# "netlify" stores files in Netlify Blobs (built into Netlify; no extra account).
#           Chosen automatically on Netlify when STORAGE_DRIVER is empty.
# "s3"      stores files in any S3-compatible object storage (AWS S3, Cloudflare
#           R2, Backblaze B2, DigitalOcean Spaces, MinIO…). Use on Vercel.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3-compatible storage (only when STORAGE_DRIVER="s3")
S3_BUCKET=""
S3_REGION="auto"
# Leave empty for AWS S3. For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: public base URL (CDN or public bucket domain) for product images,
# e.g. https://images.example.com — if empty, images are served through the app.
S3_PUBLIC_URL=""
# Bucket for private customer uploads (custom-order reference images).
# MUST be private. Defaults to S3_BUCKET — only safe if S3_BUCKET is private.
S3_PRIVATE_BUCKET=""

# Maximum accepted image upload size in megabytes (after in-browser compression).
UPLOAD_MAX_MB="4"

# ── Email (SMTP) ─────────────────────────────────────────────
# Needed for email verification, password resets and order emails.
# Any SMTP provider works (Resend, Postmark, Brevo, Amazon SES, Gmail Workspace…).
# If SMTP_HOST is empty, emails are printed to the server console in
# development and skipped (with a warning) in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The sender address, e.g. "Souvenir Galore <orders@yourdomain.com>"
EMAIL_FROM=""
# Where new-order and new-request notifications are sent (comma-separated).
ADMIN_NOTIFICATION_EMAILS=""

# ── Spam protection (optional) ───────────────────────────────
# Cloudflare Turnstile keys. When set, public forms (newsletter, contact,
# custom orders, registration) require a Turnstile check in addition to the
# built-in honeypot, timing check and rate limits.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Analytics (optional) ─────────────────────────────────────
# Plausible (cookie-free, no consent banner needed): your site domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
# Google Analytics 4 measurement ID (uses cookies — a consent banner is shown
# and GA only loads after the visitor accepts).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Scheduled housekeeping (optional) ────────────────────────
# Protects /api/cron/cleanup (daily cleanup of expired sessions, abandoned guest
# carts and unused images). On Vercel, set this and the schedule in vercel.json
# runs automatically. Elsewhere, run `npm run maintenance:cleanup` daily instead.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ── First owner account on hosts without a terminal (Netlify) ─
# When set, the production build creates the first owner account IF none
# exists yet. Delete ADMIN_PASSWORD after your first sign-in. Never commit it.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
